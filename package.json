{
        "name": "gaby-shared-album",
        "private": true,
        "workspaces": [
                "frontend",
                "backend"
        ],
        "scripts": {
                "test:backend": "npm run test --workspace backend",
                "migrate:create": "npm run migrate:create --workspace backend",
                "migrate:up": "npm run migrate:up --workspace backend",
                "migrate:down": "npm run migrate:down --workspace backend",
                "migrate:status": "npm run migrate:status --workspace backend",
                "migrate:help": "npm run migrate:help --workspace backend",
                "test:frontend": "npm run test --workspace frontend",
                "eject:frontend": "npm run eject --workspace frontend",
                "start:frontend": "npm run start --workspace frontend",
                "start:backend": "NODE_PATH=./backend/node_modules npm run start --workspace frontend",
                "build:frontend": "npm run build --workspace frontend",
                "lint": "npm run lint --workspaces",
                "ci:backend": "npm ci --production --workspace backend"
        },
        "devDependencies": {
                "@eslint/js": "^9.39.5",
                "eslint": "^8.57.1",
                "eslint-plugin-react": "^7.37.5",
                "globals": "^17.8.0"
        }
}
